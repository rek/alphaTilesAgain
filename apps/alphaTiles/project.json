{
  "name": "alphaTiles",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/alphaTiles/src",
  "projectType": "application",
  "tags": ["scope:alphaTiles", "type:app"],
  "targets": {
    "start": {
      "executor": "@nx/expo:start",
      "continuous": true,
      "dependsOn": ["prebuild-lang"],
      "options": {
        "port": 8081
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/alphaTiles/tsconfig.app.json",
        "cwd": "."
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx expo prebuild --clean",
        "cwd": "apps/alphaTiles"
      }
    },
    "run-android": {
      "executor": "@nx/expo:run",
      "dependsOn": ["prebuild-lang"],
      "options": {
        "platform": "android"
      }
    },
    "run-ios": {
      "executor": "@nx/expo:run",
      "dependsOn": ["prebuild-lang"],
      "options": {
        "platform": "ios"
      }
    },
    "buildApk": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "test -n \"$APP_LANG\" || { echo 'APP_LANG required (e.g. APP_LANG=yue)'; exit 1; }",
            "description": "Require APP_LANG"
          },
          {
            "command": "mkdir -p dist/apps/alphaTiles",
            "description": "Create dist directory"
          },
          {
            "command": "cd apps/alphaTiles && eas build --local --non-interactive --platform android --profile \"$APP_LANG-apk\" --output \"../../dist/apps/alphaTiles/alphaTiles-$APP_LANG.apk\"",
            "description": "Local EAS build: clean prebuild + eas-build-post-install manifest regen + EAS-managed release keystore"
          }
        ],
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/dist/apps/alphaTiles"]
    },
    "web-export": {
      "executor": "nx:run-commands",
      "dependsOn": ["prebuild-lang"],
      "outputs": ["{workspaceRoot}/dist/web/alpha-tiles"],
      "options": {
        "command": "npx expo export --platform web --output-dir dist/web && mkdir -p ../../dist/web/alpha-tiles && cp -r dist/web/. ../../dist/web/alpha-tiles/",
        "cwd": "apps/alphaTiles"
      }
    },
    "rsync-lang-pack": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx tools/rsync-lang-packs.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "build-stroke-data": {
      "executor": "nx:run-commands",
      "dependsOn": ["rsync-lang-pack"],
      "options": {
        "command": "npx tsx tools/build-stroke-data.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "validate-lang-pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-stroke-data"],
      "options": {
        "command": "npx tsx tools/validate-lang-pack.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "generate-lang-manifest": {
      "executor": "nx:run-commands",
      "dependsOn": ["validate-lang-pack"],
      "options": {
        "command": "npx tsx tools/generate-lang-manifest.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "prebuild-lang": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run prebuild-lang",
        "cwd": "{workspaceRoot}"
      }
    },
    "android-eng": {
      "executor": "nx:run-commands",
      "options": {
        "command": "APP_LANG=eng cd apps/alphaTiles && npx expo run:android",
        "cwd": "{workspaceRoot}"
      }
    },
    "start-web-eng": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "APP_LANG=eng npx tsx tools/generate-lang-manifest.ts && cd apps/alphaTiles && APP_LANG=eng npx expo start -w --port 8081",
        "cwd": "{workspaceRoot}"
      }
    },
    "start-web-yue": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "APP_LANG=yue npx tsx tools/build-stroke-data.ts && APP_LANG=yue npx tsx tools/generate-lang-manifest.ts && cd apps/alphaTiles && APP_LANG=yue npx expo start -w --port 8081",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
